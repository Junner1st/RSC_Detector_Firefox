{
  "manifest_version": 2,
  "name": "RSC Fingerprint Detector",
  "version": "1.0",
  "description": "Detect React Server Components (RSC) and Next.js App Router fingerprints",

  "permissions": [
    "tabs",
    "activeTab",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "{b73433a5-5a8a-4df4-ba2c-ab29034305e9}",
      "strict_min_version": "109.0"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "RSC Detector"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
